#!/usr/bin/env sh
JAVA_CMD="java"
if [ -n "${JAVA_HOME}" ] && [ -x "${JAVA_HOME}/bin/java" ] && "${JAVA_HOME}/bin/java" -version 2>&1 | grep -qE 'version "(1[7-9]|[2-9][0-9])'; then
  JAVA_CMD="${JAVA_HOME}/bin/java"
else
  for d in /Library/Java/JavaVirtualMachines/graalvm-ce-java17-*/Contents/Home \
           /Library/Java/JavaVirtualMachines/temurin-26.jdk/Contents/Home \
           /Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home \
           /Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home \
           /usr/lib/jvm/java-17-* \
           /usr/lib/jvm/temurin-17-*; do
    if [ -x "${d}/bin/java" ]; then JAVA_CMD="${d}/bin/java"; break; fi
  done
fi
exec "${JAVA_CMD}" -cp "$(dirname "$0")/../build/classes" zopyx.xform.Main "$@"
